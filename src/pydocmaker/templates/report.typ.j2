#set heading(numbering: (..nums) => {
  // 1. Convert the arguments to a regular positional array
  let parts = nums.pos()
  
  // 2. If the first item is 0, slice it off 
  if parts.at(0, default: none) == 0 {
    parts = parts.slice(1)
  }
  
  // 3. Join the remaining numbers with dots and add a trailing period
  if parts.len() > 0 {
    parts.map(str).join(".") + "."
  }
})



{% macro render_kvtable(mydict, prefix=None) %}
#table(
  columns: (auto, 1fr),
  stroke: none,
{% for key, value in mydict.items() %}
   [*{% if prefix %}{{ prefix }}{{loop.index}}{% else %}{{ key }}{% endif %}* <{{ key }}>], [{{ value }}],
{% endfor %}
)
{% endmacro %}

{% if applicables or references or acronyms %}
#heading(level: 2, outlined: false)[References]
{% endif %}

{% if acronyms %}
#heading(level: 3, outlined: false)[List of Acronyms]
{{ render_kvtable(acronyms, prefix=None) }}
{% endif %}


{% if applicables %}
#heading(level: 3, outlined: false)[List of Applicable Documents]
{{ render_kvtable(applicables, prefix="AD") }}
{% endif %}

{% if references %}
#heading(level: 3, outlined: false)[List of Reference Documents]
{{ render_kvtable(references, prefix="RD") }}
{% endif %}
